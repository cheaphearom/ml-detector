{
  "uid": "ml-detector",
  "title": "ML detector",
  "tags": [
    "pos",
    "ml-detector"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "description": "The detector's own health: is it polling and reading logs, its scores against thresholds, alerts and incidents, the POS API check, the heartbeat and Telegram.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Polls per minute",
      "description": "The live loop runs every 10 s: about 6 per minute. 0 = the detector is stopped or stuck.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" [1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lines read per minute",
      "description": "POS log lines read from Loki per minute (heartbeats not counted). 0 is normal when nobody uses the POS; whether logs arrive at all is shown by the heartbeat age.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"lines_read\" | unwrap v | __error__=\"\" [1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Heartbeat age",
      "description": "Seconds since the last heartbeat line of the POS API reached the detector (written every 30 s).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(last_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"heartbeat_age_s\" | unwrap v | __error__=\"\" [1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "POS API health check",
      "description": "Response time of the POS API's /health, every 30 s. No value = no answer.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(last_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"pos_api_check\\\"\" | json v=\"ms\" | unwrap v | __error__=\"\" [1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Anomaly score ÷ threshold (above 1 = that method alerts)",
      "description": "Each method's score divided by its own threshold, so all fit on one scale. PCA and Isolation Forest appear after training.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 2
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"score_rules\" | unwrap v | __error__=\"\" [1m])) / max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"threshold_rules\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "Rules",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"score_pca\" | unwrap v | __error__=\"\" [1m])) / max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"threshold_pca\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "PCA",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"score_isolation_forest\" | unwrap v | __error__=\"\" [1m])) / max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"threshold_isolation_forest\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "Isolation Forest",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alerts per method (5 min)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (method) (count_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"alert\\\"\" | json method=\"method\" [5m]))",
          "legendFormat": "{{method}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Incidents and system checks (5 min)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event) (count_over_time({job=\"ml-detector\"} |~ \"\\\"event\\\":\\\"(incident_opened|incident_resolved|check_down|check_up)\\\"\" | json event=\"event\" [5m]))",
          "legendFormat": "{{event}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Detection lag",
      "description": "How old the newest scored window is. About 10–20 s is normal (Loki delay + window).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"lag_s\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "seconds behind real time",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Telegram",
      "description": "Messages waiting = Telegram is unreachable and the detector is retrying.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(last_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"telegram_sent\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "sent (total)",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(last_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"telegram_pending\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "waiting",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(last_over_time({job=\"ml-detector\"} |= \"\\\"event\\\":\\\"poll\\\"\" | json v=\"telegram_dropped\" | unwrap v | __error__=\"\" [1m]))",
          "legendFormat": "dropped (total)",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Detector events: alerts, incidents, checks, training",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{job=\"ml-detector\"} != \"\\\"event\\\":\\\"poll\\\"\" != \"\\\"event\\\":\\\"pos_api_check\\\"\""
        }
      ]
    }
  ]
}