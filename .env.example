# ─── ML detector stack. Copy to .env and fill in. Never commit .env ───

# Grafana login (user admin). Choose a long password: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3001
# GRAFANA_ROOT_URL=https://grafana.example.com

# How long Loki keeps the logs (hours): 720h = 30 days
LOKI_RETENTION=720h

# Which system: pos (default) or ecommerce (the thesis system)
DETECTOR_PROFILE=pos

# Shared key with the POS API (its DETECTOR_API_KEY): openssl rand -hex 24
DETECTOR_API_KEY=

# Telegram alerts (see README): leave empty to turn them off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Detectors that may send alerts (POS default: rules,pca)
NOTIFY_METHODS=
# Seconds without an alert before "resolved"
NOTIFY_RESOLVE_AFTER_S=60
# Windows in a row an ML detector must alert before a message (POS default 4 ≈ 40 s)
NOTIFY_MIN_WINDOWS=
# Time zone of the times in the messages
NOTIFY_TIMEZONE=Asia/Phnom_Penh
