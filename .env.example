# ─── ML detector stack. Copy to .env and fill in. Never commit .env ───

# Grafana login (user admin). Choose a long password: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3001
# GRAFANA_ROOT_URL=https://grafana.example.com

# How long Loki keeps the logs (hours): 720h = 30 days
LOKI_RETENTION=720h

# Which system: pos (default) or ecommerce (the thesis system)
DETECTOR_PROFILE=pos

# Shared key with the POS API (its DETECTOR_API_KEY): openssl rand -hex 24
DETECTOR_API_KEY=

# Telegram alerts (see README): leave empty to turn them off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Detectors that may send alerts (POS default: rules,pca)
NOTIFY_METHODS=
# Seconds without an alert before "resolved"
NOTIFY_RESOLVE_AFTER_S=60
# Windows in a row an ML detector must alert before a message (POS default 4 ≈ 40 s)
NOTIFY_MIN_WINDOWS=
# Time zone of the times in the messages
NOTIFY_TIMEZONE=Asia/Phnom_Penh
# "Out of stock" messages per store and product (off = none), repeated at most every N minutes
STOCK_ALERTS=on
STOCK_ALERT_COOLDOWN_MIN=60

# ─── System checks: alerts when the POS API is down, or its logs stop arriving ───
# The POS API's health endpoint, checked every HEALTH_CHECK_INTERVAL_S seconds (empty = off).
# Same server (pos-monitoring network): http://api:3000/health (the default)
# Development, API run with `npm run dev` on Docker Desktop: http://host.docker.internal:3000/health
#POS_HEALTH_URL=http://api:3000/health
HEALTH_CHECK_INTERVAL_S=30
# Failed checks in a row before "API not responding" (2 × 30 s ≈ 1 minute)
HEALTH_FAIL_AFTER=2
# Seconds without a heartbeat line from the API before "No logs from the API" (0 = off)
HEARTBEAT_TIMEOUT_S=120

# ─── More checks (one Telegram message when a problem starts, one when it ends) ───
# The POS's public address, as the tills open it, with /health at the end. Empty = no check.
# Tailscale Funnel: https://pos.your-tailnet.ts.net/health   Cloudflare: https://pos.yourcafe.com/health
PUBLIC_HEALTH_URL=
# The server: alert when the disk is fuller than DISK_ALERT_PCT %, or less than MEMORY_ALERT_PCT % of the memory
# is available for 5 minutes. HOST_CHECKS=off turns both off.
DISK_ALERT_PCT=85
MEMORY_ALERT_PCT=10
# The POS database backups: alert when the newest is older than BACKUP_MAX_AGE_H hours (daily backup + margin),
# almost empty, or less than half the size of the one before. Default folder: ../pos-backend/deploy/backups
BACKUP_MAX_AGE_H=26
#POS_BACKUP_DIR=/home/ubuntu/pos-backend/deploy/backups

# ─── Automatic training ───
# The first model as soon as there is a day of logs, then a new one every AUTO_TRAIN_EVERY_DAYS days, at
# AUTO_TRAIN_AT (in NOTIFY_TIMEZONE), on the last AUTO_TRAIN_HOURS hours. Periods with alerts are left out; a period
# that was too unusual keeps the old model. AUTO_TRAIN=off: train only by hand.
AUTO_TRAIN=on
AUTO_TRAIN_EVERY_DAYS=7
AUTO_TRAIN_AT=04:30
AUTO_TRAIN_HOURS=24
