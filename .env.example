# ─── ML detector stack. Copy to .env and fill in. Never commit .env ───

# Grafana login (user admin). Choose a long password: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3001
# GRAFANA_ROOT_URL=https://grafana.example.com

# How long Loki keeps the logs (hours): 720h = 30 days
LOKI_RETENTION=720h

# Which system: pos (default) or ecommerce (the thesis system)
DETECTOR_PROFILE=pos

# Shared key with the POS API (its DETECTOR_API_KEY): openssl rand -hex 24
DETECTOR_API_KEY=

# Telegram alerts (see README): leave empty to turn them off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Detectors that may send alerts (POS default: rules,pca)
NOTIFY_METHODS=
# Seconds without an alert before "resolved"
NOTIFY_RESOLVE_AFTER_S=60
# Windows in a row an ML detector must alert before a message (POS default 4 ≈ 40 s)
NOTIFY_MIN_WINDOWS=
# Time zone of the times in the messages
NOTIFY_TIMEZONE=Asia/Phnom_Penh

# ─── System checks: alerts when the POS API is down, or its logs stop arriving ───
# The POS API's health endpoint, checked every HEALTH_CHECK_INTERVAL_S seconds (empty = off).
# Same server (pos-monitoring network): http://api:3000/health (the default)
# Development, API run with `npm run dev` on Docker Desktop: http://host.docker.internal:3000/health
#POS_HEALTH_URL=http://api:3000/health
HEALTH_CHECK_INTERVAL_S=30
# Failed checks in a row before "API not responding" (2 × 30 s ≈ 1 minute)
HEALTH_FAIL_AFTER=2
# Seconds without a heartbeat line from the API before "No logs from the API" (0 = off)
HEARTBEAT_TIMEOUT_S=120
